{
  "name": "@droidwire/desktop",
  "version": "1.0.0",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "electron-vite build",
    "electron": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "dist": "electron-vite build && bash scripts/bundle-native.sh && electron-builder"
  },
  "build": {
    "appId": "com.droidwire.desktop",
    "electronVersion": "42.5.0",
    "npmRebuild": false,
    "productName": "Droidwire",
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "minimumSystemVersion": "12.0"
    },
    "directories": {
      "output": "release"
    },
    "extraResources": [
      { "from": "resources/mtp-worker.cjs", "to": "mtp-worker.cjs" },
      { "from": "resources/luck-node-mtp.node", "to": "luck-node-mtp.node" },
      { "from": "resources/libmtp.9.dylib", "to": "libmtp.9.dylib" },
      { "from": "resources/libusb-1.0.0.dylib", "to": "libusb-1.0.0.dylib" },
      { "from": "resources/adb", "to": "adb" }
    ],
    "publish": {
      "provider": "github",
      "owner": "ajithonmain",
      "repo": "droidwire"
    }
  },
  "dependencies": {
    "electron-updater": "^6.1.0",
    "luck-node-mtp": "^1.0.0",
    "path-browserify": "^1.0.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "usb": "^3.0.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "electron": "^42.5.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^5.0.0",
    "playwright-core": "^1.61.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "vite": "^6.0.0"
  }
}
