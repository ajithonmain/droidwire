  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "target": "ES2020",
    "paths": {
      "@droidwire/shared": ["../shared/types"]
    }
  },
  "include": ["vite.config.ts", "src/main/**/*", "src/preload/**/*"]
}
