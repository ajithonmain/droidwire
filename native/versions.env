# Pinned sources for the native toolchain. build.sh refuses to proceed unless
# every download matches its SHA-256 here. To upgrade a component: change the
# version and URL, download it, verify it against the upstream project's
# published checksum/signature where one exists (noted below), then record the
# new SHA-256.
#
# SHA-256 provenance: libusb matches the digest GitHub shows for the release
# asset (and upstream publishes a .asc signature). The others were recorded from
# the upstream release downloads at pin time; GitHub exposes no digest for them.

DEPLOYMENT_TARGET=12.0     # lowest macOS the app (Electron 42 itself requires 12.0) supports

# AOSP adb, built with the android-tools CMake build (Apache-2.0).
# The tarball vendors the AOSP sources at tag platform-tools-37.0.0 plus
# android-tools' patches. SHA-256 matches the GitHub release asset digest.
ANDROID_TOOLS_VERSION=37.0.0
ANDROID_TOOLS_URL=https://github.com/nmeum/android-tools/releases/download/37.0.0/android-tools-37.0.0.tar.xz
ANDROID_TOOLS_SHA256=2725d09f892a3a38e534429f47a321f58ecf6a3169caa42c915fb2cb7d46be0e

# LGPL-2.1-or-later, shared libraries shipped beside the addon and adb
LIBUSB_VERSION=1.0.29
LIBUSB_URL=https://github.com/libusb/libusb/releases/download/v1.0.29/libusb-1.0.29.tar.bz2
LIBUSB_SHA256=5977fc950f8d1395ccea9bd48c06b3f808fd3c2c961b44b0c2e6e29fc3a70a85

LIBMTP_VERSION=1.1.22
LIBMTP_URL=https://github.com/libmtp/libmtp/releases/download/v1.1.22/libmtp-1.1.22.tar.gz
LIBMTP_SHA256=c3fcf411aea9cb9643590cbc9df99fa5fe30adcac695024442973d76fa5f87bc

# Static, linked into adb only
ZSTD_VERSION=1.5.7          # BSD-3-Clause (dual BSD/GPLv2; BSD option used)
ZSTD_URL=https://github.com/facebook/zstd/releases/download/v1.5.7/zstd-1.5.7.tar.gz
ZSTD_SHA256=eb33e51f49a15e023950cd7825ca74a4a2b43db8354825ac24fc1b7ee09e6fa3

LZ4_VERSION=1.10.0          # BSD-2-Clause (library)
LZ4_URL=https://github.com/lz4/lz4/releases/download/v1.10.0/lz4-1.10.0.tar.gz
LZ4_SHA256=537512904744b35e232912055ccf8ec66d768639ff3abe5788d90d792ec5f48b

BROTLI_VERSION=1.1.0        # MIT
BROTLI_URL=https://github.com/google/brotli/archive/refs/tags/v1.1.0.tar.gz
BROTLI_SHA256=e720a6ca29428b803f4ad165371771f5398faba397edf6778837a18599ea13ff

PCRE2_VERSION=10.45         # BSD-3-Clause with PCRE2 exception
PCRE2_URL=https://github.com/PCRE2Project/pcre2/releases/download/pcre2-10.45/pcre2-10.45.tar.bz2
PCRE2_SHA256=21547f3516120c75597e5b30a992e27a592a31950b5140e7b8bfde3f192033c4

ABSEIL_VERSION=20250127.1   # Apache-2.0
ABSEIL_URL=https://github.com/abseil/abseil-cpp/releases/download/20250127.1/abseil-cpp-20250127.1.tar.gz
ABSEIL_SHA256=b396401fd29e2e679cace77867481d388c807671dc2acc602a0259eeb79b7811

PROTOBUF_VERSION=29.3       # BSD-3-Clause
PROTOBUF_URL=https://github.com/protocolbuffers/protobuf/releases/download/v29.3/protobuf-29.3.tar.gz
PROTOBUF_SHA256=008a11cc56f9b96679b4c285fd05f46d317d685be3ab524b2a310be0fbad987e

# Header only: gtest_prod.h (FRIEND_TEST macro) is included by AOSP's libziparchive
GOOGLETEST_VERSION=1.15.2   # BSD-3-Clause
GOOGLETEST_URL=https://github.com/google/googletest/releases/download/v1.15.2/googletest-1.15.2.tar.gz
GOOGLETEST_SHA256=7b42b4d6ed48810c5362c265a17faebe90dc2373c885e5216439d37927f02926
