{
  "name": "droidwire",
  "version": "1.4.0",
  "private": true,
  "license": "MIT",
  "description": "Android file management for macOS over USB ADB, wireless ADB and MTP",
  "workspaces": [
    "desktop",
    "shared"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "rebuild:mtp": "node scripts/rebuild-mtp.mjs",
    "desktop:dev": "npm --prefix desktop run dev",
    "desktop:build": "npm --prefix desktop run build",
    "desktop:dist": "npm --prefix desktop run dist",
    "typecheck": "npm --prefix desktop run typecheck",
    "test": "npm --prefix desktop test",
    "verify": "npm --prefix desktop run verify",
    "native:build": "bash native/build.sh",
    "license:inventory": "node scripts/license-inventory.mjs",
    "license:scan": "license-checker-rseidelsohn --summary"
  },
  "devDependencies": {
    "license-checker-rseidelsohn": "5.0.1",
    "node-gyp": "^12.4.0",
    "patch-package": "^8.0.1"
  }
}
